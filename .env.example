# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql://app:app@localhost:5440/saas

# --- Auth (AuthProvider) ---
# local: JWTs issued by this API. cognito: tokens issued by an AWS Cognito user pool.
AUTH_PROVIDER=local
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_EXPIRES_IN=1h
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Payments (PaymentProvider) ---
# fake: local HMAC-signed webhooks, no Stripe account needed. stripe: real Stripe API.
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=change-me-webhook-signing-secret
STRIPE_SECRET_KEY=
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# --- Invites ---
INVITE_TTL_HOURS=168
