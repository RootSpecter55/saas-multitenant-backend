generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String?      @map("password_hash")
  externalId   String?      @unique @map("external_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  memberships  Membership[]
  invitesSent  Invite[]

  @@map("users")
}

/// Row-level security: visible only when app.current_org_id = id.
model Organisation {
  id           String        @id @db.Uuid
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  memberships  Membership[]
  invites      Invite[]
  subscription Subscription?
  usageRecords UsageRecord[]

  @@map("organisations")
}

/// Row-level security on org_id.
model Membership {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  role         Role
  createdAt    DateTime     @default(now()) @map("created_at")
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Row-level security on org_id.
model Invite {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  email        String
  role         Role
  tokenHash    String       @unique @map("token_hash")
  invitedById  String       @map("invited_by_id") @db.Uuid
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invites")
}

model Plan {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique
  name              String
  priceCents        Int            @map("price_cents")
  maxMembers        Int            @map("max_members")
  monthlyUsageQuota Int            @map("monthly_usage_quota")
  providerPriceId   String?        @map("provider_price_id")
  subscriptions     Subscription[]

  @@map("plans")
}

/// Row-level security on org_id.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  orgId                  String             @unique @map("org_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  organisation           Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// Row-level security on org_id.
model UsageRecord {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  metric       String
  quantity     Int
  recordedAt   DateTime     @default(now()) @map("recorded_at")
  organisation Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, metric, recordedAt])
  @@map("usage_records")
}

/// Webhook idempotency: one row per provider event. The unique constraint rejects replays.
model ProcessedWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String   @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}
